// Prisma schema: database tables are defined here as "models".
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  // Generated inside src/ so NestJS compiles it together with the app
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Exercise library ────────────────────────────────────────────────

/// Main purpose of an exercise
enum ExerciseGoal {
  STRENGTH
  AEROBIC
  RESPIRATORY
  BALANCE
  MOBILITY
}

/// An exercise in the library that physios can assign to patients
model Exercise {
  id                String       @id @default(uuid())
  name              String
  description       String
  videoUrl          String?
  goal              ExerciseGoal
  level             Int          @default(1)
  equipment         String[] // e.g. ["chair", "resistance band"]; empty = no equipment
  contraindications String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  routineExercises         RoutineExercise[]
  routineTemplateExercises RoutineTemplateExercise[]
}

// ─── Authentication ──────────────────────────────────────────────────

enum UserRole {
  ADMIN
  PHYSIO
  PATIENT
}

/// A login account. Profile data lives in Physiotherapist / Patient.
/// Physios and admins log in with email + password; patients pair a device with a QR code.
model User {
  id           String    @id @default(uuid())
  role         UserRole
  email        String?   @unique // stored lowercase; null for patients
  passwordHash String? // argon2 hash; null for patients
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  physiotherapist Physiotherapist?
  patient         Patient?
  sessions        Session[]
}

/// WEB = physio panel (cookie), DEVICE = patient app (Bearer header)
enum SessionKind {
  WEB
  DEVICE
}

/// A logged-in browser or device. Only the SHA-256 hash of the token is stored.
model Session {
  id         String      @id @default(uuid())
  userId     String
  tokenHash  String      @unique
  kind       SessionKind
  deviceName String?
  expiresAt  DateTime
  lastUsedAt DateTime    @default(now())
  revokedAt  DateTime? // set on logout or when a device is unlinked
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── People ──────────────────────────────────────────────────────────

/// A physiotherapist who manages their own patients
model Physiotherapist {
  id            String   @id @default(uuid())
  userId        String   @unique
  fullName      String
  licenseNumber String?  @unique // professional registration number
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  patients Patient[]
}

enum Sex {
  FEMALE
  MALE
}

/// A patient's clinical profile. No identifying data here (see PatientIdentity).
/// Patients are never deleted (clinical records must be kept): they are discharged.
model Patient {
  id                String    @id @default(uuid())
  userId            String    @unique
  physiotherapistId String
  sex               Sex?
  weightKg          Float? // at the initial assessment
  heightCm          Int?
  diagnosis         String
  stage             String? // e.g. "IIIA"
  currentTreatment  String?
  surgeryDate       DateTime? @db.Date
  comorbidities     String[]
  initialAssessment String?
  dischargedAt      DateTime? // null = active patient
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  physiotherapist Physiotherapist  @relation(fields: [physiotherapistId], references: [id])
  identity        PatientIdentity?
  programs        Program[]

  @@index([physiotherapistId])
}

/// Identifying data, kept apart from clinical data (GDPR pseudonymisation)
model PatientIdentity {
  id         String   @id @default(uuid())
  patientId  String   @unique
  fullName   String
  birthDate  DateTime @db.Date
  phone      String?
  nationalId String?  @unique // DNI/NIE
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// ─── Programs ────────────────────────────────────────────────────────

/// Clinical profile a program is designed for
enum ProgramProfile {
  PREHAB
  POST_SURGERY
  DURING_TREATMENT
  SURVIVOR
}

enum ProgramStatus {
  ACTIVE
  ENDED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// A patient's exercise program.
/// A patient has one ACTIVE program at most; older ones are ENDED (kept as history, read-only).
model Program {
  id        String          @id @default(uuid())
  patientId String
  name      String
  profile   ProgramProfile?
  status    ProgramStatus   @default(ACTIVE)
  startDate DateTime        @default(now()) @db.Date
  endDate   DateTime?       @db.Date // set when the program ends
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  patient  Patient   @relation(fields: [patientId], references: [id])
  routines Routine[]

  @@index([patientId])
}

/// A fixed session the patient repeats on some days of the week ("Rutina A: L X V").
/// A program has 1–2 routines; a day belongs to at most one routine (other days are rest).
model Routine {
  id         String    @id @default(uuid())
  programId  String
  templateId String? // the template it was loaded from, if any (kept for traceability)
  name       String
  order      Int // 1, 2… (display order)
  daysOfWeek Weekday[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  program   Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  template  RoutineTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  exercises RoutineExercise[]

  @@index([programId])
  @@index([templateId])
}

// ─── Routine templates ───────────────────────────────────────────────

/// A pre-established routine in the shared library (any physio can create, edit or delete it).
/// Loading it into a program copies its exercises; later changes to the template don't affect programs.
/// No days: the physio chooses them per patient.
model RoutineTemplate {
  id          String          @id @default(uuid())
  name        String
  profile     ProgramProfile?
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  exercises RoutineTemplateExercise[]
  routines  Routine[]
}

/// One exercise of a routine template (same prescription fields as RoutineExercise)
model RoutineTemplateExercise {
  id              String   @id @default(uuid())
  templateId      String
  exerciseId      String
  order           Int
  sets            Int
  reps            Int?
  durationSec     Int?
  restSec         Int
  targetEffortPct Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  template RoutineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id])

  @@index([templateId])
  @@index([exerciseId])
}

/// One exercise inside a routine, with its prescription
model RoutineExercise {
  id              String   @id @default(uuid())
  routineId       String
  exerciseId      String
  order           Int // position in the session, starting at 1
  sets            Int
  reps            Int? // either reps or durationSec, depending on the exercise
  durationSec     Int?
  restSec         Int
  targetEffortPct Int? // target perceived effort, 0–100 in steps of 10 (50 = 5/10)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  routine  Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@index([routineId])
  @@index([exerciseId])
}
